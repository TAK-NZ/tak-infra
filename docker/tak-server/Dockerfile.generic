FROM eclipse-temurin:17-jammy
LABEL org.opencontainers.image.source=https://github.com/tak-nz/takserver
LABEL org.opencontainers.image.description="TAK server for deployment with AWS ECS"
LABEL org.opencontainers.image.licenses=MIT
ARG TAK_VERSION=takserver-docker-5.8-RELEASE-103
RUN apt update \
    && apt-get install -y net-tools netcat gradle \
        tini cron certbot curl libxml2-utils xmlstarlet unzip zip awscli jq postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# AWS KMS PKCS#11 module: lets OpenSSL sign CA certificates with the Root CA and Intermediate CA
# keys in AWS KMS (#136). The keys never leave KMS. Pinned release with a checksum (GitHub also
# publishes these digests for the release assets). libp11 provides the OpenSSL "pkcs11" engine.
ARG KMS_PKCS11_VERSION=v0.0.19
ARG KMS_PKCS11_SHA256_X86_64=b41b3cc0c339bf80a336adcd38818a75841e08a2d24ab225de617514407e8344
ARG KMS_PKCS11_SHA256_AARCH64=08154b3298994d70cad0736b12edd7c47098146f67ab738617a1aa96e05aef88
RUN apt-get update \
    && apt-get install -y --no-install-recommends libengine-pkcs11-openssl libjson-c5 \
    && ARCH="$(uname -m)" \
    && case "${ARCH}" in \
         x86_64)  SHA="${KMS_PKCS11_SHA256_X86_64}" ;; \
         aarch64) SHA="${KMS_PKCS11_SHA256_AARCH64}" ;; \
         *) echo "Unsupported architecture ${ARCH}" >&2; exit 1 ;; \
       esac \
    && mkdir -p /usr/lib/pkcs11 \
    && curl -fsSL -o /usr/lib/pkcs11/aws_kms_pkcs11.so \
         "https://github.com/JackOfMostTrades/aws-kms-pkcs11/releases/download/${KMS_PKCS11_VERSION}/aws_kms_pkcs11-ubuntu22.04-${ARCH}.so" \
    && echo "${SHA}  /usr/lib/pkcs11/aws_kms_pkcs11.so" | sha256sum -c - \
    && chmod 755 /usr/lib/pkcs11/aws_kms_pkcs11.so \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV PKCS11_MODULE_PATH=/usr/lib/pkcs11/aws_kms_pkcs11.so
ENV HOME=/opt/tak
WORKDIR $HOME

COPY ./takserver-docker-*.zip $HOME/

ENV TAK_VERSION=${TAK_VERSION}

RUN unzip "./${TAK_VERSION}.zip" \
    && EXTRACTED_DIR=$(find . -maxdepth 1 -type d -name 'takserver-docker*' -not -name '.') \
    && rm -rf "${EXTRACTED_DIR}/docker" \
    && mv "${EXTRACTED_DIR}"/tak/* ./ \
    && rmdir "${EXTRACTED_DIR}/tak" \
    && rmdir "${EXTRACTED_DIR}"

COPY ./docker-container/ $HOME/

# Patch JVM flags into configureInDocker.sh (merged into same RUN as chmod so that
# Docker layer caching cannot skip the patch when docker-container/ is unchanged):
#   -XX:G1HeapRegionSize=16m  raises the humongous allocation threshold from ~1MB to 16MB,
#                             preventing G1GC from treating normal Ignite cache objects as
#                             humongous and triggering the GC storm seen in the OOM incident
#   -XX:+HeapDumpOnOutOfMemoryError  write heap dump to EFS on OOM for post-mortem analysis
#   -XX:HeapDumpPath             persistent-config is EFS-mounted, survives container replacement
#   -Xlog:gc*                    GC log to EFS for diagnosing future GC pressure events
COPY ./docker/tak-server/patch-jvm-flags.py /tmp/
RUN chmod +x /opt/tak/scripts/start-tak.sh \
    && chmod +x /opt/tak/scripts/download-plugin-config.sh \
    && chmod +x /opt/tak/scripts/kms-ca.sh \
    && chmod +x /opt/tak/scripts/pki-bootstrap.sh \
    && chmod +x /opt/tak/scripts/cert-metrics.sh \
    && chmod +x /opt/tak/scripts/cluster-lock.sh \
    && chmod +x /opt/tak/scripts/certbot-renew.sh \
    && chmod +x /opt/tak/scripts/server-cert-rotate.sh \
    && chmod +x /opt/tak/scripts/admin-cert-rotate.sh \
    && chmod +x /opt/tak/scripts/pki-rotate.sh \
    && chmod +x /opt/tak/scripts/pki-trust.sh \
    && chmod +x /opt/tak/scripts/revoke-cert.sh \
    && chmod +x /opt/tak/scripts/rotation-coverage.sh \
    && chmod +x /opt/tak/scripts/admin-p12-reexport.sh \
    && python3 /tmp/patch-jvm-flags.py \
    && grep 'G1HeapRegionSize' /opt/tak/configureInDocker.sh \
    && rm /tmp/patch-jvm-flags.py

# Build tak-gpt plugin
COPY ./docker/tak-server/extract-tak-deps.sh /tmp/
COPY ./docker/tak-server/plugin-build.gradle /tmp/
COPY ./plugins/tak-gpt /tmp/tak-gpt
RUN chmod +x /tmp/extract-tak-deps.sh \
    && cd /tmp \
    && ./extract-tak-deps.sh "${HOME}/${TAK_VERSION}.zip" /tmp/tak-plugin-libs || echo "Warning: Failed to extract TAK deps" \
    && cd /tmp/tak-gpt \
    && rm -rf ./lib/src/main/java/com/google/common \
    && cp /tmp/plugin-build.gradle ./lib/build.gradle \
    && cd /tmp/tak-gpt \
    && chmod +x gradlew \
    && ./gradlew :lib:clean :lib:shadowJar --no-daemon --no-configuration-cache --no-build-cache \
    && mkdir -p /opt/tak/lib \
    && cp lib/build/libs/tak-gpt-all.jar /opt/tak/lib/ \
    && chown 1000:1000 /opt/tak/lib/tak-gpt-all.jar \
    && cd / \
    && rm -rf /tmp/tak-gpt /tmp/tak-plugin-libs /tmp/*.sh /tmp/*.gradle /root/.gradle \
    && rm -f "${HOME}"/takserver-docker-*-RELEASE-*.zip

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/opt/tak/scripts/start-tak.sh"]
