# Configuration file for TAK Server
#
# Every variable below is actually read by docker-container/scripts/createCoreConfig.sh.
# See docs/TAKSERVER_CORECONFIG.md for the full reference, including which
# settings are silently overridden by CDK context regardless of what is set
# here.
#
# CoreConfig.xml is fully regenerated from this file (plus CDK context) on
# every container start. Settings not listed in this file are NOT
# configurable via this mechanism -- see docs/TAKSERVER_CORECONFIG.md before
# adding a variable that isn't already documented there.

# CA Configuration
# Configuration for TAK-server built-in CA. Only used on first boot, when no
# CA certificate exists yet. Consumed by start-tak.sh, not createCoreConfig.sh.
#
TAKSERVER_CACert_Country=NZ
TAKSERVER_CACert_State=Wellington
TAKSERVER_CACert_City=Wellington
TAKSERVER_CACert_Org=TAK.NZ
TAKSERVER_CACert_OrgUnit=TAK.NZ Operations

# Input Configuration
#
# Authenticate users on the CoT data port (8089) via x509 cert or ldap
# Valid: x509, ldap | Default: x509
TAKSERVER_CoreConfig_Network_Input_8089_Auth=x509

# When true, connections on 8089 that do not present a valid credential
# (e.g. no client certificate) are rejected outright at the socket level
# instead of being silently admitted with no identity/groups. Leaving this
# false allows anonymous, unroutable connections to be accepted and archived.
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Network_Input_8089_AuthRequired=true

# When false, CoTs received on 8089 are routed to connected clients only and
# not persisted to the database.
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Network_Input_8089_Archive=true

# Always archive mission-related CoT messages, independent of the setting
# above.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Network_AlwaysArchiveMissionCot=false

# Mission Settings
#
# When true, mission content inherits the mission's groups instead of the
# uploading user's groups.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Network_MissionUseGroupsForContents=false

# Prevents mission map items from being added to other missions or being
# broadcast outside the mission context.
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Network_MissionStrictUidMissionMembership=true

# Regex restricting which LDAP groups may create missions. Leave unset for
# no restriction.
# Default: unset (no restriction)
TAKSERVER_CoreConfig_Network_MissionCreateGroupsRegex=^tak_.*$

# Limits mission deletion to users with the MISSION_OWNER role on that
# mission.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Network_MissionDeleteRequiresOwner=false

# Allows updating groups on an existing mission, including its content.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Network_MissionAllowGroupChange=false

# Delivers mission map items to subscribers when added via the API service,
# not just via Messaging.
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Network_MissionBrokerUidAddsFromApi=true

# Disables broadcasting of map items to all subscribers.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Network_DisableBroadcastMapItems=false

# X.509 Group Cache Configuration
#
# Default auth backend.
# Valid: ldap, file | Default: ldap
TAKSERVER_CoreConfig_Auth_Default=ldap

# Enables the X.509 group cache system, allowing certificate-authenticated
# users to have "active"/"inactive" groups.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Auth_X509useGroupCache=true

# New users' first groups are marked "active" by default.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Auth_X509useGroupCacheDefaultActive=true

# LDAP Auth Configuration
#
# Group name prefix filter. Only consider LDAP groups prefixed with "tak_",
# but remove the prefix from the actual group name in TAK.
# NOTE: silently overridden by CDK's takserver.ldapGroupPrefix context if
# that key is set -- see docs/TAKSERVER_CORECONFIG.md.
# Default: cn=tak_
TAKSERVER_CoreConfig_Auth_LDAP_Groupprefix=cn=tak_

# Regex used to extract the group name from the matched LDAP group DN.
# Must literally start with "cn=" + the Groupprefix value above (a plain,
# case-sensitive String.startsWith() check on the raw config text) for TAK
# Server's group-description lookup (searchGroups) to re-prepend the prefix
# before its exact-match LDAP search -- otherwise that lookup searches for
# the un-prefixed name and never matches, silently leaving group
# descriptions empty for ATAK/CloudTAK clients. The match itself is still
# case-insensitive at runtime, so this also matches "CN=" in real DN values.
# NOTE: silently overridden by CDK's takserver.ldapGroupPrefix context if
# that key is set -- see docs/TAKSERVER_CORECONFIG.md.
# Default: cn=tak_(.*?)(?:,|$)
TAKSERVER_CoreConfig_Auth_LDAP_GroupNameExtractorRegex=cn=tak_(.*?)(?:,|$)

# LDAP group granted TAK Server admin rights.
# Default: unset
TAKSERVER_CoreConfig_Auth_LDAP_AdminGroup=ServerAdmin

# Enables LDAP connection pooling.
# NOTE: the JDK's JNDI LDAP provider does not pool SSL connections by default
# -- only "plain" (non-SSL) connections are poolable unless the JVM system
# property com.sun.jndi.ldap.connect.pool.protocol=plain ssl is also set
# (which cannot be set here; it requires a JVM -D flag). Since our LDAP URL
# is always ldaps://, enabling this without that system property is a no-op:
# no connections are actually pooled. Left disabled until that system
# property is added (deliberately not done yet -- see docs/TAKSERVER_CORECONFIG.md
# for the tradeoffs).
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Auth_LDAP_EnableConnectionPool=false

# LDAP connection pool timeout, in milliseconds.
# Default: 30000
TAKSERVER_CoreConfig_Auth_LDAP_ConnectionPoolTimeout=30000

# LDAP object class used to identify user entries during search.
# Default: inetOrgPerson
TAKSERVER_CoreConfig_Auth_LDAP_UserObjectClass=inetOrgPerson

# LDAP object class used to identify group entries during search.
# Default: groupOfNames
TAKSERVER_CoreConfig_Auth_LDAP_GroupObjectClass=groupOfNames

# LDAP User Base RDN and Group Base RDN. MUST be fully qualified with the base
# DN (do not use a bare relative RDN here) -- the LDAP URL itself (CDK builds
# it as just "<LdapsEndpoint>", e.g. "ldaps://ldap.tak.nz:636") does not carry
# the base DN. A relative RDN here breaks X.509 group lookups: TAK Server's
# ctx.lookup() calls resolve names relative to the URL's JNDI namespace root,
# and a base-DN-carrying URL combined with fully-qualified DN fields elsewhere
# (userstring, serviceAccountDN) silently doubles the base DN suffix and
# matches nothing. See docs/TAKSERVER_CORECONFIG.md for the full explanation.
# NOT overridden by CDK -- set these here if your directory uses different
# organizational units.
# Default: ou=users,<your base DN>
TAKSERVER_CoreConfig_Auth_LDAP_UserBaseRDN=ou=users,dc=ldap,dc=tak
# Default: ou=groups,<your base DN>
TAKSERVER_CoreConfig_Auth_LDAP_GroupBaseRDN=ou=groups,dc=ldap,dc=tak

# OAuth/OIDC Server Support
#
# NOTE: If cdk.json's webtak.enableOidc is true AND the WebTAK OIDC secret
# exists, CDK sets Name/Scope/Issuer/ClientId/RedirectUri/AuthEndpoint/
# TokenEndpoint/Secret/UsernameClaim directly as ECS environment/secrets
# entries, which always override the S3 values below for the same keys.
# The settings below therefore only take effect when WebTAK OIDC is
# disabled (webtak.enableOidc=false, or no OIDC secret configured) -- e.g.
# for a standalone/non-WebTAK OIDC provider. See docs/TAKSERVER_CORECONFIG.md.
#
# Setting OAuthServer_Name triggers generation of the <oauth> section; if
# unset, none of the other OAuth settings below have any effect.
# Default: unset
TAKSERVER_CoreConfig_OAuthServer_Name=TAK.NZ Account

# JWT claim used as the username.
# Default: preferred_username
TAKSERVER_CoreConfig_OAuth_UsernameClaim=preferred_username

# Path to the issuer's public key file (downloaded separately by
# getOIDCIssuerPubKey.sh using OAuthServer_JWKS below).
TAKSERVER_CoreConfig_OAuthServer_Issuer=/opt/tak/certs/files/oauth-public-key.pem

# JWKS endpoint used by getOIDCIssuerPubKey.sh to download the public key
# referenced by OAuthServer_Issuer above. Not read by createCoreConfig.sh
# directly.
TAKSERVER_CoreConfig_OAuthServer_JWKS=https://account.tak.nz/application/o/tak-server/jwks/

TAKSERVER_CoreConfig_OAuthServer_ClientId=abcdefg12345
TAKSERVER_CoreConfig_OAuthServer_Secret=mysupersecretsecret
TAKSERVER_CoreConfig_OAuthServer_RedirectUri=https://ops.tak.nz:8446/login/redirect
TAKSERVER_CoreConfig_OAuthServer_Scope=openid profile
TAKSERVER_CoreConfig_OAuthServer_AuthEndpoint=https://account.tak.nz/application/o/authorize/
TAKSERVER_CoreConfig_OAuthServer_TokenEndpoint=https://account.tak.nz/application/o/token/

# Disable TLS certificate validation for this OAuth server. Development only.
# Valid: true, false | Default: false
# NOT overridden by CDK -- always takes effect if OAuthServer_Name is set.
TAKSERVER_CoreConfig_OAuthServer_TrustAllCerts=false

# OIDC Discovery Trust (second, independent OIDC provider)
#
# A second OIDC trust entry, resolved via a discovery document instead of a
# manually-configured auth/token endpoint pair -- e.g. for trusting a
# separate application/provider (such as CloudTAK's own Authentik OIDC
# application) for M2M bearer-token validation, in addition to the
# OAuthServer entry above. See docs/TAKSERVER_CORECONFIG.md.
#
# NOTE: Unlike OAuthServer_* above, none of these settings are ever touched
# by CDK -- this is purely an S3 config file mechanism, including the client
# secret. Only set these if you're running TAK Server together with
# CloudTAK and want TAK Server to trust CloudTAK's own OIDC application;
# leave this whole block unset if not using CloudTAK.
#
# Setting OIDCDiscovery_Name triggers generation of the
# <openIdDiscoveryConfiguration> element; if unset, none of the other
# OIDCDiscovery settings below have any effect.
# Default: unset
TAKSERVER_CoreConfig_OIDCDiscovery_Name=CloudTAK

TAKSERVER_CoreConfig_OIDCDiscovery_ClientId=abcdefg12345
TAKSERVER_CoreConfig_OIDCDiscovery_Secret=mysupersecretsecret
TAKSERVER_CoreConfig_OIDCDiscovery_RedirectUri=https://map.tak.nz/login/redirect
TAKSERVER_CoreConfig_OIDCDiscovery_ConfigurationUri=https://account.tak.nz/application/o/cloudtak/.well-known/openid-configuration

# Disable TLS certificate validation for this provider. Development only.
# Valid: true, false | Default: false
TAKSERVER_CoreConfig_OIDCDiscovery_TrustAllCerts=false

# Federation Configuration
#
# Enables/disables the <federation> element and federation-server generation.
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Federation_EnableFederation=true

# Locate Configuration
#
# Setting Locate_Group triggers creation of the <locate> element; if unset,
# none of the other Locate settings below have any effect.
# Default: unset
TAKSERVER_CoreConfig_Locate_Group=cn=tak_locate

# Valid: true, false | Default: false
TAKSERVER_CoreConfig_Locate_Enabled=false
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Locate_RequireLogin=true
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Locate_AddToMission=true
# Valid: true, false | Default: true
TAKSERVER_CoreConfig_Locate_Broadcast=true
# CoT type used for Locate reports.
# Default: a-f-G
TAKSERVER_CoreConfig_Locate_CotType=a-f-G
# Mission name to add Locate reports to. Only applied if set.
# Default: unset
TAKSERVER_CoreConfig_Locate_Mission=Locate
