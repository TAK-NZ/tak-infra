# GHSA-mh99-v99m-4gvg: brace-expansion DoS bundled inside aws-cdk-lib's
# minimatch dependency cannot be fixed via package.json overrides, since npm
# overrides do not apply to bundled dependencies. Ignored until aws-cdk-lib
# ships a release bundling brace-expansion >=5.0.8 (current: aws-cdk-lib 2.262.1
# bundles brace-expansion 5.0.7). Re-check on every aws-cdk-lib upgrade.
audit-level=critical
